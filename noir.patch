+/**
+ * Noir wharf-left diagnosis: scripts to full-trace, opcode by opcode.
+ * 001B3003 = alkhalifollow global process, 14EBD3DC = wharf entrance,
+ * 14EBD455 = wharf init (calls CALLGLOBALPROCESS), 14EBE813 = wharf left-exit cinematic.
+ */
+static bool NoirTracedScript(uint32 hCode) {
+	return hCode == 0x001B3003 || hCode == 0x14EBD3DC || hCode == 0x14EBD455 || hCode == 0x14EBE813;
+}
+
+/**
+ * One-shot dump of a traced script's bytecode to a file in the CWD, for
+ * offline static disassembly (we only ever see the executed path at runtime).
+ */
+static void NoirDumpScriptOnce(const INT_CONTEXT *ic) {
+	static uint32 dumped[8];
+	if (!ic->code)
+		return;
+	for (int i = 0; i < 8; i++) {
+		if (dumped[i] == ic->hCode)
+			return;
+		if (dumped[i] == 0) {
+			dumped[i] = ic->hCode;
+			Common::DumpFile df;
+			Common::String name = Common::String::format("noir-script-%08X.bin", ic->hCode);
+			if (df.open(Common::Path(name))) {
+				df.write(ic->code, 1024);
+				df.close();
+				debug(1, "NoirDumpScript: wrote %s (1024 bytes)", name.c_str());
+			}
+			return;
+		}
+	}
+}
