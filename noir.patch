+void Spriter::ResolvePalette(const Common::Array<uint> &previousDepth) {
+#if defined(USE_TINYGL)
+	Graphics::Surface &surface = _vm->screen();
+	assert(surface.format == Graphics::PixelFormat(2, 5, 6, 5, 0, 11, 5, 0, 0));
+	const uint *depth = TinyGL::gl_get_context()->fb->getZBuffer();
+	uint count = 0, minShade = PALETTE_COUNT, maxShade = 0;
+	for (int y = 0; y < surface.h; ++y) {
+		uint16 *pixels = (uint16 *)surface.getBasePtr(0, y);
+		for (int x = 0; x < surface.w; ++x) {
+			// Shadow pixels already contain RGB. Only a depth change from
+			// this textured pass owns a temporary palette index.
+			if (depth[y * surface.w + x] == previousDepth[y * surface.w + x])
+				continue;
+			const uint16 value = pixels[x];
+			const uint index = ((value >> 11) << 3) | ((value & 31) >> 2);
+			const uint shade = MIN<uint>(((value >> 5) & 63) / 3, PALETTE_COUNT - 1);
+			pixels[x] = _palette[shade * 256 + index];
+			++count;
+			minShade = MIN(minShade, shade);
+			maxShade = MAX(maxShade, shade);
+		}
+	}
+	if (++_lightFrames % 120 == 1)
+		debug(2, "Noir lighting: type %d palettes %u pixels %u shade %u..%u",
+			_lightType, uint(_palette.size() / 256), count, minShade, maxShade);
+#endif
+}
