--- /dev/null
+++ b/engines/tinsel/noir/test_crt.h
@@ -0,0 +1,20 @@
+// Process-local failure routing for the opt-in MSVC headless Noir test.
+#ifndef TINSEL_NOIR_TEST_CRT_H
+#define TINSEL_NOIR_TEST_CRT_H
+
+#if defined(_MSC_VER)
+#include <stdlib.h>
+#include <crtdbg.h>
+
+inline void configureNoirTestCrt(_CRT_REPORT_HOOK fatalReport) {
+	// Standard assert uses _wassert; _CrtSetReportMode alone does not cover it.
+	_set_error_mode(_OUT_TO_STDERR);
+	_set_abort_behavior(0, _WRITE_ABORT_MSG | _CALL_REPORTFAULT);
+	for (int kind = _CRT_WARN; kind <= _CRT_ASSERT; ++kind) {
+		_CrtSetReportMode(kind, _CRTDBG_MODE_FILE);
+		_CrtSetReportFile(kind, _CRTDBG_FILE_STDERR);
+	}
+	_CrtSetReportHook(fatalReport);
+}
+#endif
+#endif
