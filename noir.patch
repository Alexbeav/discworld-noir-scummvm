+bool Handle::IsValidSaveHandle(SCNHANDLE offset, uint32 bytes) const {
+	const uint32 index = offset >> SCNHANDLE_SHIFT;
+	const uint32 position = offset & ((1u << SCNHANDLE_SHIFT) - 1);
+	if (index >= _numHandles)
+		return false;
+	const uint32 size = _handleTable[index].filesize & FSIZE_MASK;
+	return position <= size && bytes <= size - position && size != 8;
+}
+
+bool Handle::IsValidSaveFilm(SCNHANDLE offset, int reel) const {
+	assert(TinselVersion == 3);
+	if (reel < 0 || !IsValidSaveHandle(offset, sizeof(FILM)))
+		return false;
+	const MEMHANDLE *entry = _handleTable + (offset >> SCNHANDLE_SHIFT);
+	const uint32 size = entry->filesize & FSIZE_MASK;
+	const byte *data = entry->_node && (MEMFLAGS(entry) & fLoaded) ? MemoryDeref(entry->_node) : nullptr;
+	Common::Array<byte> unloaded;
+	if (!data) {
+		// Preflight must not select a disc or load into the live scene heap.
+		// The normal restore changes discs before reconstructing actor films.
+		char filename[sizeof(entry->szName) + 1];
+		memcpy(filename, entry->szName, sizeof(entry->szName));
+		filename[sizeof(entry->szName)] = 0;
+		Common::File file;
+		if (!file.open(filename))
+			return false;
+		unloaded.resize(size);
+		const uint32 bytes = entry->flags2 & fCompressed ?
+			decompressLZSS(file, unloaded.data(), size) : file.read(unloaded.data(), size);
+		if (bytes != size || file.err())
+			return false;
+		data = unloaded.data();
+	}
+	const uint32 position = offset & OFFSETMASK;
+	const int32 count = READ_LE_INT32(data + position + 4);
+	return count > 0 && (uint32)count <= (size - position - 8) / sizeof(FREEL) && reel < count;
+}
+
