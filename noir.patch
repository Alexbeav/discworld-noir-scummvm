+void ClearNoirGroundPlane() {
+	if (TinselVersion != 3)
+		return;
+	const int savedDistance = g_noirGround.savedDistance;
+	g_noirGround = NoirGroundState();
+	g_noirGround.savedDistance = savedDistance;
+}
+
+bool NoirGroundPlaneTo3D(int x, int y, int &xOut, int &yOut, int &zOut) {
+	if (TinselVersion != 3 || g_noirGround.polygon == NOPOLY)
+		return false;
+	int passes = 0;
+	const NoirGroundPoint p = noirSolveGroundPoint({x, y}, false, passes);
+	yOut = noirGroundInt(-(int64)p.y);
+	// The PS1 corrections approximate integer GTE projection. The PC uses
+	// a different float perspective matrix: invert that same renderer matrix
+	// on the solver's fixed-Y plane instead of returning its residual error.
+	// PC 430F1C / 430D5C use exact requested pixels; the PS1 even-pixel
+	// seed above must not move a PC destination outside its authored PATH.
+	if (!_vm->_spriter->ScreenToSceneGround(x, y, yOut, xOut, zOut))
+		return false;
+	g_noirGround.lastResult = {xOut, p.y, noirGroundInt(-(int64)zOut)};
+	NoirGroundScreen screen;
+	_vm->_spriter->TransformSceneXYZ(xOut, yOut, zOut, screen.x, screen.y);
+	noirStoreGroundPair(g_noirGround.lastResult, screen);
+	debug(2, "ScreenToModel: (%d,%d) -> (%d,%d,%d) err (%d,%d) passes %d view %d",
+		x, y, xOut, yOut, zOut, screen.x - x, screen.y - y, passes, g_noirGround.view);
+	return true;
+}
+
+void NoirGroundTest(int &points, int &maxErrorX, int &maxErrorY) {
+	points = maxErrorX = maxErrorY = 0;
+	if (TinselVersion != 3 || g_noirGround.polygon == NOPOLY)
+		return;
+	const NoirGroundState saved = g_noirGround;
+	// PATH and solver coordinates are world pixels. The captain camera keeps
+	// its authored floor below the visible image; test active PATH extents.
+	int left = INT_MAX, top = INT_MAX, right = INT_MIN, bottom = INT_MIN;
+	for (int i = 0; i < noofPolys; i++) {
+		if (!Polys[i] || Polys[i]->polyType != PATH)
+			continue;
+		for (int c = 0; c < 4; c++) {
+			left = MIN<int>(left, Polys[i]->cx[c]);
+			top = MIN<int>(top, Polys[i]->cy[c]);
+			right = MAX<int>(right, Polys[i]->cx[c]);
+			bottom = MAX<int>(bottom, Polys[i]->cy[c]);
+		}
+	}
+	if (left == INT_MAX)
+		return;
+	debug(1, "Noir ground PATH bounds: (%d,%d)-(%d,%d)", left, top, right, bottom);
+	for (int y = (top + 15) & ~15; y <= bottom; y += 16) {
+		for (int x = (left + 15) & ~15; x <= right; x += 16) {
+			if (InPolygon(x, y, PATH) == NOPOLY)
+				continue;
+			int mx, my, mz, sx, sy;
+			if (!NoirGroundPlaneTo3D(x, y, mx, my, mz)) {
+				maxErrorX = SCREEN_WIDTH;
+				maxErrorY = SCREEN_HEIGHT;
+				points++;
+				continue;
+			}
+			_vm->_spriter->TransformSceneXYZ(mx, my, mz, sx, sy);
+			if (ABS(sx - x) > maxErrorX || ABS(sy - y) > maxErrorY)
+				debug(1, "Noir ground worst: view %d pixel (%d,%d) model (%d,%d,%d) projected (%d,%d)",
+					g_noirGround.view, x, y, mx, my, mz, sx, sy);
+			maxErrorX = MAX(maxErrorX, ABS(sx - x));
+			maxErrorY = MAX(maxErrorY, ABS(sy - y));
+			points++;
+		}
+	}
+	g_noirGround = saved;
+}
