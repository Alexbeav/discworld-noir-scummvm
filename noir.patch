+// PC 0x410D98 uses tan^2(5-degree steps), selecting rows 0..17.
+static int LightVertexShade(const Math::Vector3d &v, const Math::Vector3d &a, const Math::Vector3d &b) {
+	const Math::Vector3d edge = b - a;
+	const float length = edge.x() * edge.x() + edge.y() * edge.y();
+	if (length == 0)
+		return 0;
+	const float t = ((v.x() - a.x()) * edge.x() + (v.y() - a.y()) * edge.y()) / length;
+	const Math::Vector3d delta = v - (a + edge * t);
+	const float distance = delta.x() * delta.x() + delta.y() * delta.y();
+	// The original uses 255 for zero height and compares from row 17.
+	// PC 0x410E2A FDIVRP divides projected distance by squared height,
+	// rather than its reciprocal. A nonzero height at zero XY distance
+	// is dark; a zero height takes the original special value 255.
+	const float slope = delta.z() == 0 ? 255.0f :
+		distance / (4 * delta.z() * delta.z());
+	static const float thresholds[18] = {0, .0076542664f, .0310912039f, .0717967674f,
+		.132474333f, .217442825f, .33333334f, .49029058f, .70408821f, 1,
+		1.42027664f, 2.03960681f, 3, 4.59890985f, 7.54863214f, 13.92820358f,
+		32.1634369f, 130.646103f};
+	for (int i = 17; i > 0; --i)
+		if (thresholds[i] < slope)
+			return i;
+	return 0;
+}
