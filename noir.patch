+		const int index = _noirConvIndices[i];
+		if (index >= 0 && index < _invD[INV_CONV].NoofItems && _invD[INV_CONV].contents[index] == id) {
+			const Common::Rect &area = _noirConvAreas[i];
+			point = Common::Point(_invD[INV_CONV].inventoryX + (area.left + area.right) / 2,
