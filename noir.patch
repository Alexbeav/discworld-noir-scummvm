+
+void Dialogs::fillNoirConversation() {
+	dumpIconArray();
+	memset(_iconAnims, 0, sizeof(_iconAnims));
+	for (int i = 0; i < MAX_ICONS; ++i)
+		_noirConvIndices[i] = NOOBJECT;
+
+	int n = 0, icons = 0, texts = 0;
+	for (int index = 0; index < _invD[INV_CONV].NoofItems && n < MAX_ICONS; ++index) {
+		const int id = _invD[INV_CONV].contents[index];
+		const bool permanent = index < _numPermIcons;
+		if (!permanent && index < _numPermIcons + _invD[INV_CONV].FirstDisp)
+			continue;
+		const bool text = getInvObject(id)->hasAttribute(InvObjAttr::V3ATTR_X1000);
+		if (!permanent && text && texts >= _invD[INV_CONV].NoofVicons)
+			continue;
+
+		SCNHANDLE script;
+		int speed;
+		_iconArray[n] = addInvObject(id, &script, &speed);
+		// PS1 FUN_8002d738 positions permanent icons at +250,+65,
+		// other icons at +32,+70 (96 pitch), and text at +16,+160 (22 pitch).
+		int x = permanent ? 250 + index * 96 : (text ? 16 : 32 + icons * 96);
+		int y = permanent ? 65 : (text ? 160 + texts * 22 : 70);
+		if (_iconArray[n]) {
+			MultiSetAniXYZ(_iconArray[n], _invD[INV_CONV].inventoryX + x,
+				_invD[INV_CONV].inventoryY + y, Z_INV_ICONS);
+			if (script)
+				InitStepAnimScript(&_iconAnims[n], _iconArray[n], script, speed);
+			_noirConvIndices[n] = index;
+			// Authored hit areas from FUN_8002e7fc, independent of text length.
+			_noirConvAreas[n] = text ? Common::Rect(16, y + 4, 439, y + 22)
+				: Common::Rect(x, y, x + 84, y + (permanent ? 74 : 84));
+			debug(2, "Noir conversation: item %d index %d type %s at (%d,%d)",
+				id, index, text ? "text" : "icon", _invD[INV_CONV].inventoryX + x,
+				_invD[INV_CONV].inventoryY + y);
+			++n;
+		}
+		if (!permanent) {
+			if (text) ++texts;
+			else ++icons;
+		}
+	}
+}
