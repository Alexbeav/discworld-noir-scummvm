+#ifdef ENABLE_EVENTRECORDER
+// Optional before/after surfaces on a scheduled capture: retain the actual
+// underlay without suppressing or moving an authored object.
+void TinselEngine::captureNoirBlend(const DRAWOBJECT &object, bool after) {
+	if (_noirTestRoute.empty() || !ConfMan.hasKey("noir_test_blend_probe") ||
+		!ConfMan.getBool("noir_test_blend_probe"))
+		return;
+	const uint tick = _noirTestTick + 1 - _noirTestDelay;
+	bool capture = false;
+	for (uint i = _noirTestIndex; i < _noirTestRoute.size(); ++i) {
+		uint next = 0;
+		char command[16] = {};
+		if (sscanf(_noirTestRoute[i].c_str(), "%u %15s", &next, command) != 2 || next > tick)
+			break;
+		if (next == tick && !strcmp(command, "capture"))
+			capture = true;
+	}
+	if (!capture)
+		return;
+	const Common::String name = Common::String::format("blend-%06u-%08X-%s.png",
+		tick, object.hBits, after ? "after" : "before");
+	Common::FSNode path = Common::FSNode(ConfMan.getPath("noir_test_output")).getChild(name);
+	if (path.exists())
+		return;
+	Common::DumpFile out;
+	if (!out.open(path) || !Image::writePNG(out, screen()) || !out.flush())
+		error("Cannot write Noir blend probe: %s", name.c_str());
+	if (!after)
+		debug(2, "noirblend: tick %u bits %08X flags %d rle %d origin (%d,%d) size (%d,%d) clip (%d,%d,%d,%d)",
+			tick, object.hBits, object.colorFlags, object.isRLE, object.xPos, object.yPos,
+			object.width, object.height, object.leftClip, object.topClip, object.rightClip, object.botClip);
+}
+
+#if defined(_MSC_VER)
+static int noirTestCrtReport(int kind, char *message, int *) {
+	if (kind == _CRT_ASSERT || kind == _CRT_ERROR) {
+		warning("Noir headless CRT failure: %s", message);
+		abort();
+	}
+	return 0;
+}
+#endif
+// Test-only input enters through the event manager, so the native recorder retains it.
+// Ticks count completed game cycles, including movies, rather than event polls.
+void TinselEngine::initNoirTestRoute() {
+	if (TinselVersion != 3 || !ConfMan.hasKey("noir_test_route"))
+		return;
+	if (!ConfMan.hasKey("noir_test_output"))
+		error("noir route requires noir_test_output");
+	if (ConfMan.get("record_mode") != "record" && ConfMan.get("record_mode") != "playback" &&
+		ConfMan.get("record_mode") != "none")
+		error("noir route requires record, playback or explicit none mode");
+	Common::File file;
+	if (!file.open(Common::FSNode(ConfMan.getPath("noir_test_route"))))
+		error("Cannot open noir test route");
+	while (!file.eos()) {
+		Common::String line = file.readLine();
+		line.trim();
+		if (!line.empty() && line[0] != '#')
+			_noirTestRoute.push_back(line);
+	}
+	if (_noirTestRoute.empty())
+		error("Empty noir test route");
+	// The recorder resets global verbosity to1. Restore only an explicitly
+	// requested diagnostic level for this opt-in Tinsel3 route.
+	if (ConfMan.hasKey("noir_test_debug_level")) {
+		const int level = ConfMan.getInt("noir_test_debug_level");
+		if (level < 1 || level > 2)
+			error("Noir test debug level must be 1 or 2");
+		gDebugLevel = level;
+	}
+	debug(1, "noirroute: start commands %u playback %d", _noirTestRoute.size(),
+		ConfMan.get("record_mode") == "playback");
+}
+
+void TinselEngine::stepNoirTestRoute() {
+	++_noirTestTick;
+	while (_noirTestIndex < _noirTestRoute.size()) {
+		uint tick = 0;
+		char command[16] = {};
+		int x = 0, y = 0;
+		const int fields = sscanf(_noirTestRoute[_noirTestIndex].c_str(), "%u %15s %d %d", &tick, command, &x, &y);
+		const uint routeTick = _noirTestTick - _noirTestDelay;
+		if (fields < 2 || tick < routeTick)
+			error("Invalid or unordered noir route at line %u", _noirTestIndex + 1);
+		if (tick != routeTick)
+			break;
+		if (!strcmp(command, "topic") || !strcmp(command, "menu") || !strcmp(command, "clue") || !strcmp(command, "item") || !strcmp(command, "ready")) {
+			const bool ready = !strcmp(command, "ready");
+			Common::Point point;
+			if (fields != (ready ? 2 : 3))
+				error("Noir %s has invalid argument count", command);
+			MOVER *lead = ready ? GetMover(_actor->GetLeadId()) : nullptr;
+			bool available = ready && (!lead || !MoverMoving(lead));
+			if (!strcmp(command, "clue") || !strcmp(command, "item")) {
+				// Find a real hit in the currently open authored notebook page.
+				for (int cy = 10; cy < screen().h && !available; cy += 10) {
+					for (int cx = 10; cx < screen().w; cx += 10) {
+						const bool book = !strcmp(command, "clue");
+						const bool bag = !_notebook->isOpen() && _dialogs->inventoryActive() &&
+							(_dialogs->whichInventoryOpen() == INV_1 || _dialogs->whichInventoryOpen() == INV_2);
+						if ((book ? _notebook->GetPointedClue(Common::Point(cx, cy)) :
+							(bag ? _dialogs->invItemId(cx, cy) : 0)) == x) {
+							point = Common::Point(cx, cy);
+							available = true;
+							break;
+						}
+					}
+				}
+			} else if (!ready) {
+				available = !strcmp(command, "topic") ? _dialogs->getNoirTopicPoint(x, point) :
+					_dialogs->getNoirMenuPoint(x, point);
+			}
+			if (!ControlIsOn() || !available) {
+				// Let newly encountered speech finish without sending an Escape.
+				// A missing target while control is available still fails promptly.
+				++_noirTestWaits;
+				_noirTestTargetWaits = ControlIsOn() && !ready ? _noirTestTargetWaits + 1 : 0;
+				if (_noirTestWaits > 6000 || _noirTestTargetWaits > 120) {
+					warning("noirroute: FAILED %s %d unavailable after %u total/%u controlled game cycles at tick %u actual %u",
+						command, x, _noirTestWaits, _noirTestTargetWaits, tick, _noirTestTick);
+					static_cast<Console *>(getDebugger())->cmd_noirstate(0, nullptr);
+					DebugNoirSaveState();
+					// Abort only the opt-in route through its normal quit event.
+					// Engine assertions and fatal errors retain their existing path.
+					Common::Event stop;
+					stop.type = Common::EVENT_QUIT;
+					g_system->getEventManager()->pushEvent(stop);
+					_noirTestIndex = _noirTestRoute.size();
+					return;
+				}
+				++_noirTestDelay;
+				return;
+			}
+			debug(1, "noirroute %s: tick %u actual %u item %d target (%d,%d) waited %u",
+				command, tick, _noirTestTick, x, point.x, point.y, _noirTestWaits);
+			_noirTestWaits = 0;
+			_noirTestTargetWaits = 0;
+			if (!ready) {
+				x = point.x;
+				y = point.y;
+			}
+		}
+		++_noirTestIndex;
+		debug(1, "noirroute: tick %u command %s (%d,%d)", tick, command, x, y);
+		Console *console = static_cast<Console *>(getDebugger());
+		if (!strcmp(command, "capture")) {
+			Common::FSNode dir(ConfMan.getPath("noir_test_output"));
+			Common::DumpFile out;
+			const Common::String name = Common::String::format("tick-%06u.png", tick);
+			if (dir.getChild(name).exists())
+				error("Noir capture already exists: %s", name.c_str());
+			if (!out.open(dir.getChild(name)) || !Image::writePNG(out, screen()) || !out.flush())
+				error("Cannot write noir capture: %s", name.c_str());
+			if (ConfMan.hasKey("noir_test_backend_captures") && ConfMan.getBool("noir_test_backend_captures")) {
+				g_system->saveScreenshot();
+			}
+			console->cmd_noirstate(0, nullptr);
+			_dialogs->debugNoirSettings();
+			DebugNoirSaveState();
+			const MOVER *mover = GetMover(_actor->GetLeadId());
+			if (mover && mover->type == MOVER_3D && mover->bPos3D) {
+				const Model &model = _spriter->_modelMain;
+				debug(1, "noirpose: frames (%d,%d) time %u rotation (%.3f,%.3f,%.3f) renderpos (%.5f,%.5f,%.5f)",
+					model.startFrame, model.endFrame, model.time,
+					model.rotation.x(), model.rotation.y(), model.rotation.z(),
+					model.position.x(), model.position.y(), model.position.z());
+#if defined(USE_TINYGL)
+				const TinyGL::GLContext *context = TinyGL::gl_get_context();
+				const uint *depth = context->fb->getZBuffer();
+				int left = screen().w, top = screen().h, right = -1, bottom = -1;
+				uint pixels = 0;
+				for (int py = 0; py < screen().h; ++py) {
+					for (int px = 0; px < screen().w; ++px) {
+						if (!depth[py * screen().w + px])
+							continue;
+						left = MIN(left, px); top = MIN(top, py);
+						right = MAX(right, px); bottom = MAX(bottom, py); ++pixels;
+					}
+				}
+				debug(1, "noirraster: model pixels %u bounds (%d,%d,%d,%d) viewport (%d,%d)",
+					pixels, left, top, right, bottom, context->viewport.xsize, context->viewport.ysize);
+#endif
+			}
+			continue;
+		}
+		if (!strcmp(command, "ready"))
+			continue;
+		if (!strcmp(command, "ground")) {
+			console->cmd_groundtest(0, nullptr);
+			continue;
+		}
+		// Playback supplies input exclusively from route.bin. Diagnostic commands run in both modes.
+		if (ConfMan.get("record_mode") == "playback")
+			continue;
+		if (!strcmp(command, "savefail")) {
+			if (fields != 3 || x < 0 || x > 2)
+				error("Noir savefail requires 0=off, 1=write, 2=finalize");
+			ConfMan.set("noir_test_save_failure", x == 1 ? "write" : (x == 2 ? "finalize" : ""));
+			continue;
+		}
+		Common::Event event;
+		if (!strcmp(command, "press") || !strcmp(command, "release")) {
+			x = _mousePos.x;
+			y = _mousePos.y;
+			debug(1, "noirroute button: tick %u target (%d,%d)", tick, x, y);
+		}
+		if (!strcmp(command, "key")) {
+			if (fields != 3 || (x != 8 && x != 13 && (x < 32 || x > 126)))
+				error("Noir key requires ASCII 8, 13 or 32..126");
+			event.type = Common::EVENT_KEYDOWN;
+			event.kbd.ascii = x;
+			event.kbd.keycode = static_cast<Common::KeyCode>(x >= 'A' && x <= 'Z' ? x + 'a' - 'A' : x);
+		} else if (!strcmp(command, "move") || !strcmp(command, "topic") || !strcmp(command, "menu") || !strcmp(command, "clue") || !strcmp(command, "item") || !strcmp(command, "down") ||
+			!strcmp(command, "up") || !strcmp(command, "press") || !strcmp(command, "release")) {
+			if ((!strcmp(command, "move") || !strcmp(command, "down") || !strcmp(command, "up")) && fields != 4)
+				error("Noir route mouse point requires x y");
+			if (x < 0 || x >= screen().w || y < 0 || y >= screen().h)
+				error("Noir route mouse point out of bounds");
+			event.type = (!strcmp(command, "move") || !strcmp(command, "topic") || !strcmp(command, "menu") || !strcmp(command, "clue") || !strcmp(command, "item")) ? Common::EVENT_MOUSEMOVE :
+				((!strcmp(command, "down") || !strcmp(command, "press")) ? Common::EVENT_LBUTTONDOWN : Common::EVENT_LBUTTONUP);
+			event.mouse = Common::Point(x, y + (g_system->getHeight() - screen().h) / 2);
+		} else if (!strcmp(command, "quit")) {
+			event.type = Common::EVENT_QUIT;
+		} else {
+			event.type = Common::EVENT_CUSTOM_ENGINE_ACTION_START;
+			if (!strcmp(command, "escape")) event.customType = kActionEscape;
+			else if (!strcmp(command, "pageup")) event.customType = kActionPageUp;
+			else if (!strcmp(command, "pagedown")) event.customType = kActionPageDown;
+			else if (!strcmp(command, "options")) event.customType = kActionOptionsDialog;
+			else if (!strcmp(command, "notebook")) event.customType = kActionNotebook;
+			else if (!strcmp(command, "inventory")) event.customType = kActionInventory;
+			else if (!strcmp(command, "walk")) event.customType = kActionWalkTo;
+			else if (!strcmp(command, "action")) event.customType = kActionAction;
+			else if (!strcmp(command, "look")) event.customType = kActionLook;
+			else error("Unknown noir route command: %s", command);
+		}
+		g_system->getEventManager()->pushEvent(event);
+	}
+}
+#endif
