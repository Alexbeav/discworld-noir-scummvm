+// NOIR_GROUND_SOLVER_BEGIN: exercised by the project's check-noir-ground.py.
+struct NoirGroundPoint {
+	int x, y, z;
+};
+
+struct NoirGroundScreen {
+	int x, y;
+};
+
+struct NoirGroundPair {
+	NoirGroundPoint model;
+	NoirGroundScreen screen;
+};
+
+struct NoirGroundState {
+	HPOLYGON polygon = NOPOLY;
+	int view = -1;
+	int scale = 1;
+	NoirGroundPoint reference = {};
+	int64 map[3][3] = {};
+	NoirGroundPair pairs[200] = {};
+	int pairCount = 0;
+	int savedDistance = 100;
+	bool lastValid = false;
+	NoirGroundScreen lastRequest = {};
+	NoirGroundPoint lastResult = {};
+};
+
+static NoirGroundState g_noirGround;
+static void noirProjectGroundPoint(const NoirGroundPoint &p, NoirGroundScreen &screen);
+
+static int noirGroundInt(int64 value) {
+	return (int)CLIP<int64>(value, -2147483647 - 1LL, 2147483647);
+}
+
+static int64 noirGroundError(const NoirGroundScreen &request, const NoirGroundScreen &screen) {
+	return ABS((int64)request.x - screen.x) + ABS((int64)request.y - screen.y);
+}
+
+// PS1 SDK sqrt table is floor(sqrt(64..255)*512), not a rounded sqrt.
+static int noirGroundSqrt(uint64 value) {
+	if (!value)
+		return 0;
+	uint64 normalized = value;
+	int shift = 0;
+	while (normalized > 255) {
+		normalized >>= 2;
+		shift++;
+	}
+	while (normalized < 64) {
+		normalized <<= 2;
+		shift--;
+	}
+	uint64 root = (uint64)(sqrt((double)normalized) * 512.0);
+	if (shift + 3 >= 0)
+		root <<= shift + 3;
+	else
+		root >>= -(shift + 3);
+	return noirGroundInt(root >> 12);
+}
+
+static void noirStoreGroundPair(const NoirGroundPoint &p, const NoirGroundScreen &screen) {
+	for (int i = 0; i < g_noirGround.pairCount; i++) {
+		if (g_noirGround.pairs[i].screen.x == screen.x && g_noirGround.pairs[i].screen.y == screen.y)
+			return;
+	}
+	if (g_noirGround.pairCount < 200)
+		g_noirGround.pairs[g_noirGround.pairCount++] = {p, screen};
+}
+
+static void noirNearestGroundPair(const NoirGroundScreen &request, NoirGroundPoint &p, NoirGroundScreen &screen) {
+	int64 error = noirGroundError(request, screen);
+	for (int i = 0; i < g_noirGround.pairCount; i++) {
+		const NoirGroundPair &entry = g_noirGround.pairs[i];
+		const int64 nextError = noirGroundError(request, entry.screen);
+		if (nextError < error) {
+			p = entry.model;
+			screen = entry.screen;
+			error = nextError;
+		}
+	}
+}
