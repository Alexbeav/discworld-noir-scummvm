+static void WaitNoirSequence(CORO_PARAM, MOVER *mover, int myEscape) {
+	CORO_BEGIN_CONTEXT;
+		uint generation;
+		uint completed;
+	CORO_END_CONTEXT(_ctx);
+	CORO_BEGIN_CODE(_ctx);
+
+	_ctx->generation = _vm->_spriter->SequenceGeneration();
+	_ctx->completed = _vm->_spriter->CompletedSequences();
+	// PC461760 waits for natural completion or escape, then only restores
+	// standing if no later SetSequence replaced the sequence it started.
+	do {
+		CORO_SLEEP(1);
+	} while ((!myEscape || myEscape == GetEscEvents()) &&
+	         _ctx->completed == _vm->_spriter->CompletedSequences());
+	if (_ctx->generation == _vm->_spriter->SequenceGeneration())
+		CORO_INVOKE_2(T3SetMoverStanding, mover, true);
+
+	CORO_END_CODE;
+}
+
+struct NOIR_SEQUENCE_MONITOR {
+	MOVER *mover;
+	int myEscape;
+};
+
+static void NoirSequenceMonitor(CORO_PARAM, const void *param) {
+	const NOIR_SEQUENCE_MONITOR *monitor = (const NOIR_SEQUENCE_MONITOR *)param;
+	WaitNoirSequence(coroParam, monitor->mover, monitor->myEscape);
+}
+
+static void PlayNoirSequence(CORO_PARAM, int sequence, int direction, int speed, int flags, int myEscape) {
+	CORO_BEGIN_CONTEXT;
+		MOVER *mover;
+	CORO_END_CONTEXT(_ctx);
+	CORO_BEGIN_CODE(_ctx);
+
+	if (myEscape && myEscape != GetEscEvents())
+		return;
+	_ctx->mover = GetMover(LEAD_ACTOR);
+	assert(_ctx->mover && _ctx->mover->type == MOVER_3D);
+	// PC44A570 lazily loads the authored supplemental bank before sequence.
+	if (!_vm->_spriter->HasOverlay() && SysVar(SV_SPRITER_OVERLAY))
+		_vm->_spriter->LoadOverlay(SysVar(SV_SPRITER_OVERLAY));
+	_vm->_spriter->SetSequence(sequence, 4);
+	if (direction != -1)
+		_ctx->mover->dir3D = direction;
+	_ctx->mover->animSpeed = speed;
+	_ctx->mover->nextIdleAnim = 0;
+	if (flags & 0x20) {
+		CORO_INVOKE_2(WaitNoirSequence, _ctx->mover, myEscape);
+	} else if (!(flags & 0x40)) {
+		NOIR_SEQUENCE_MONITOR monitor = {_ctx->mover, myEscape};
+		CoroScheduler.createProcess(PID_TCODE, NoirSequenceMonitor, &monitor, sizeof(monitor));
+	}
+
+	CORO_END_CODE;
+}
+
+static void WaitNoirFrame(CORO_PARAM, int frameNumber, int myEscape) {
+	CORO_BEGIN_CONTEXT;
+	CORO_END_CONTEXT(_ctx);
+	CORO_BEGIN_CODE(_ctx);
+
+	// PC463AE4 polls exact current frame, even if the sequence is replaced.
+	while (_vm->_spriter->CurrentFrame() != frameNumber) {
+		if (myEscape && myEscape != GetEscEvents())
+			break;
+		CORO_SLEEP(1);
+	}
+	CORO_END_CODE;
+}
