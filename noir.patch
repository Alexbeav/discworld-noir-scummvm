+// FUN_800443dc, lines 19368-19395: integer elimination BEFORE <<10.
+static bool noirBuildGroundMap(const NoirGroundPoint p[3], const NoirGroundScreen s[3]) {
+	const int64 t = (int64)s[1].x - s[0].x;
+	const int64 u = (int64)s[1].x * s[0].y - (int64)s[0].x * s[1].y;
+	const int64 v = (int64)s[2].x - s[1].x;
+	const int64 d = v * u - t * ((int64)s[1].y * s[2].x - (int64)s[2].y * s[1].x);
+	if (!d || !t || !s[0].x)
+		return false;
+	for (int axis = 0; axis < 3; axis++) {
+		const int q0 = axis == 0 ? p[0].x : axis == 1 ? p[0].y : p[0].z;
+		const int q1 = axis == 0 ? p[1].x : axis == 1 ? p[1].y : p[1].z;
+		const int q2 = axis == 0 ? p[2].x : axis == 1 ? p[2].y : p[2].z;
+		const int64 r = (int64)q0 * s[1].x - (int64)q1 * s[0].x;
+		const int64 b = (v * r - t * ((int64)q1 * s[2].x - (int64)q2 * s[1].x)) / d;
+		const int64 c = (r - b * u) / t;
+		const int64 a = ((int64)q0 - b * s[0].y - c) / s[0].x;
+		g_noirGround.map[axis][0] = a * 1024;
+		g_noirGround.map[axis][1] = b * 1024;
+		g_noirGround.map[axis][2] = c * 1024;
+	}
+	return true;
+}
+
+static int noirGroundLineStep(const NoirGroundScreen &request, const NoirGroundScreen &origin,
+		const NoirGroundScreen &probe, int step) {
+	const int64 a = (int64)origin.y - probe.y;
+	const int64 b = (int64)probe.x - origin.x;
+	const int64 c = (int64)origin.x * probe.y - (int64)probe.x * origin.y;
+	const int64 divisor = a * a + b * b;
+	if (!divisor)
+		return 0;
+	const int64 x = (b * b * request.x - a * b * request.y - a * c) / divisor;
+	const int64 y = (a * a * request.y - a * b * request.x - b * c) / divisor;
+	if (ABS(x) >= ABS(y) && x != origin.x && probe.x != origin.x)
+		return noirGroundInt((int64)step * (x - origin.x) / ((int64)probe.x - origin.x));
+	if (y != origin.y && probe.y != origin.y)
+		return noirGroundInt((int64)step * (y - origin.y) / ((int64)probe.y - origin.y));
+	if (x != origin.x && probe.x != origin.x)
+		return noirGroundInt((int64)step * (x - origin.x) / ((int64)probe.x - origin.x));
+	return 0;
+}
+
+static int noirGroundAddClamped(int value, int delta) {
+	const int64 next = (int64)value + delta;
+	if ((value < 0 && next > 0) || (value > 0 && next < 0))
+		return 0;
+	return noirGroundInt(next);
+}
+
+// FUN_80024508: project +Z and +X, take half the line corrections.
+static int64 noirGroundMethodA(const NoirGroundScreen &request, NoirGroundPoint &p,
+		const NoirGroundScreen &origin, int step) {
+	NoirGroundScreen screen;
+	NoirGroundPoint probe = p;
+	probe.z = noirGroundInt((int64)probe.z + step);
+	noirProjectGroundPoint(probe, screen);
+	const int dz = noirGroundLineStep(request, origin, screen, step);
+	probe = p;
+	probe.x = noirGroundInt((int64)probe.x + step);
+	noirProjectGroundPoint(probe, screen);
+	const int dx = noirGroundLineStep(request, origin, screen, step);
+	p.x = noirGroundAddClamped(p.x, dx / 2);
+	p.z = noirGroundAddClamped(p.z, dz / 2);
+	noirProjectGroundPoint(p, screen);
+	return noirGroundError(request, screen);
+}
+
+// FUN_800249f4: project +X and -Z; average available Q12 ratios.
+static int64 noirGroundMethodB(const NoirGroundScreen &request, NoirGroundPoint &p,
+		const NoirGroundScreen &origin, int step) {
+	NoirGroundScreen sx, sz;
+	NoirGroundPoint probe = p;
+	probe.x = noirGroundInt((int64)probe.x + step);
+	noirProjectGroundPoint(probe, sx);
+	probe = p;
+	probe.z = noirGroundInt((int64)probe.z - step);
+	noirProjectGroundPoint(probe, sz);
+	const int64 dx = (int64)request.x - origin.x;
+	const int64 dy = (int64)request.y - origin.y;
+	const int64 xx = (int64)request.x - sx.x, xy = (int64)request.y - sx.y;
+	const int64 zx = (int64)request.x - sz.x, zy = (int64)request.y - sz.y;
+	const int64 detX = xy * zx - zy * xx;
+	int countX = 3, countZ = 3;
+	int64 x0 = 0, x1 = 0, x2 = 0, z0 = 0, z1 = 0, z2 = 0;
+	if (!detX) {
+		countX = 2;
+		countZ = 1;
+	} else {
+		x0 = (zx * dy - zy * dx) * 4096 / detX;
+		if (zx)
+			z1 = (dx * 4096 - x0 * xx) / zx;
+		else
+			countZ = 2;
+		if (zy)
+			z2 = (dy * 4096 - x0 * xy) / zy;
+		else
+			countZ--;
+	}
+	const int64 detZ = xx * zy - xy * zx;
+	if (!detZ) {
+		countZ--;
+		countX -= 2;
+	} else {
+		z0 = (xx * dy - xy * dx) * 4096 / detZ;
+		if (xx)
+			x1 = (dx * 4096 - z0 * zx) / xx;
+		else
+			countX--;
+		if (xy)
+			x2 = (dy * 4096 - z0 * zy) / xy;
+		else
+			countX--;
+	}
+	if (!countX || !countZ)
+		return noirGroundError(request, origin);
+	p.x = noirGroundInt((int64)p.x + ((x0 + x1 + x2) / countX) * step / 4096);
+	p.z = noirGroundInt((int64)p.z - ((z0 + z1 + z2) / countZ) * step / 4096);
+	NoirGroundScreen screen;
+	noirProjectGroundPoint(p, screen);
+	return noirGroundError(request, screen);
+}
+
+// FUN_80024f98: map, nearest pair, four steps, store, mirror, nearest pair.
+static NoirGroundPoint noirSolveGroundPoint(NoirGroundScreen request, bool mirrored, int &passes, int limit = 3) {
+	request.x &= ~1;
+	request.y &= ~1;
+	if (g_noirGround.lastValid && request.x == g_noirGround.lastRequest.x && request.y == g_noirGround.lastRequest.y)
+		return g_noirGround.lastResult;
+	NoirGroundPoint p;
+	int *axes[3] = {&p.x, &p.y, &p.z};
+	for (int axis = 0; axis < 3; axis++) {
+		const int64 *row = g_noirGround.map[axis];
+		*axes[axis] = noirGroundInt((row[0] * request.x + row[1] * request.y + row[2]) * g_noirGround.scale / 1024);
+	}
+	NoirGroundScreen screen;
+	noirProjectGroundPoint(p, screen);
+	noirNearestGroundPair(request, p, screen);
+	const int64 dx = (int64)g_noirGround.reference.x - p.x / g_noirGround.scale;
+	const int64 dy = (int64)g_noirGround.reference.y - p.y / g_noirGround.scale;
+	const int64 dz = (int64)g_noirGround.reference.z - p.z / g_noirGround.scale;
+	const uint64 distance = dx * dx + dy * dy + dz * dz;
+	if (distance)
+		g_noirGround.savedDistance = noirGroundSqrt(distance + noirGroundSqrt(distance));
+	const int step = noirGroundInt((int64)g_noirGround.savedDistance * 5);
+	for (int i = 0; i <= limit; i++) {
+		NoirGroundPoint a = p, b = p;
+		const int64 errorA = noirGroundMethodA(request, a, screen, step);
+		const int64 errorB = noirGroundMethodB(request, b, screen, step);
+		const NoirGroundPoint previous = p;
+		p = errorB < errorA ? b : a;
+		passes++;
+		noirProjectGroundPoint(p, screen);
+		if (!noirGroundError(request, screen) || (p.x == previous.x && p.z == previous.z))
+			break;
+	}
+	noirStoreGroundPair(p, screen);
+	if (!mirrored) {
+		if (noirGroundError(request, screen)) {
+			const NoirGroundScreen reflection = {
+				noirGroundInt((int64)request.x * 2 - screen.x),
+				noirGroundInt((int64)request.y * 2 - screen.y)};
+			const NoirGroundPoint other = noirSolveGroundPoint(reflection, true, passes, limit);
+			NoirGroundScreen otherScreen;
+			noirProjectGroundPoint(other, otherScreen);
+			if (noirGroundError(request, otherScreen) < noirGroundError(request, screen))
+				p = other;
+		}
+		// Preserve the PS1's pre-mirror error baseline for this lookup.
+		noirNearestGroundPair(request, p, screen);
+	}
+	// Departure: the outer result must be cached under the outer request.
+	g_noirGround.lastRequest = request;
+	g_noirGround.lastResult = p;
+	g_noirGround.lastValid = true;
+	return p;
+}
+// NOIR_GROUND_SOLVER_END
+
+static void noirProjectGroundPoint(const NoirGroundPoint &p, NoirGroundScreen &screen) {
+	_vm->_spriter->TransformSceneXYZ(p.x, noirGroundInt(-(int64)p.y), noirGroundInt(-(int64)p.z), screen.x, screen.y);
+}
