+// PC417063: 41 encoded bytes contain 32 interleaved stereo frames.
+void BMVPlayer::PrepNoirAudio(const byte *sourceData, int blobCount, bool oddOffset, byte *destPtr) {
+	static const int scales[16] = {16384, 8192, 4096, 2048, 1152, 768, 512, 352,
+		256, 176, 128, 96, 64, 44, 28, 16};
+	while (blobCount-- > 0) {
+		const byte header = sourceData[oddOffset ? 0 : 40];
+		const byte *payload = sourceData + (oddOffset ? 1 : 0);
+		for (int channel = 0; channel < 2; ++channel) {
+			uint16 previous = channel ? Au_Prev2 : Au_Prev1;
+			const int scale = scales[channel ? (header & 15) : (header >> 4)];
+			int highBits = 0;
+			int sample = 0;
+			for (int wordIndex = 0; wordIndex < 10; ++wordIndex) {
+				const uint16 word = READ_LE_UINT16(payload + channel * 20 + wordIndex * 2);
+				highBits = (highBits << 1) | (word >> 15);
+				for (int shift = 10; shift >= 0; shift -= 5) {
+					const int value = (word >> shift) & 31;
+					previous += ((value < 16 ? value : value - 32) * scale) >> 4;
+					WRITE_LE_UINT16(destPtr + sample++ * 4 + channel * 2, previous);
+				}
+			}
+			for (int shift = 5; shift >= 0; shift -= 5) {
+				const int value = (highBits >> shift) & 31;
+				previous += ((value < 16 ? value : value - 32) * scale) >> 4;
+				WRITE_LE_UINT16(destPtr + sample++ * 4 + channel * 2, previous);
+			}
+			if (channel)
+				Au_Prev2 = previous;
+			else
+				Au_Prev1 = previous;
+		}
+		sourceData += 41;
+		destPtr += 128;
+		oddOffset = !oddOffset;
+	}
+}
