+	if (flags & MODEL_HAS_SCALE_TABLE) {
+		uint n = GetAnimationFrameCount(hunks, anim.scaleTablesHunk, anim.scaleTables);
+		numFrames = (numFrames == 0) ? n : MIN(numFrames, n);
+	}
+	anim.maxFrame = (numFrames > 0) ? numFrames - 1 : 0;
