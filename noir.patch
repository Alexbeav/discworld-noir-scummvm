+int Dialogs::noirConversationItem(int *x, int *y, bool update) {
+	if (_InventoryHidden || _inventoryState != ACTIVE_INV)
+		return NOOBJECT;
+	for (int i = 0; i < MAX_ICONS && _iconArray[i]; ++i) {
+		const Common::Rect &area = _noirConvAreas[i];
+		if (area.contains(*x - _invD[INV_CONV].inventoryX, *y - _invD[INV_CONV].inventoryY)) {
+			if (update) {
+				*x = _invD[INV_CONV].inventoryX + area.left;
+				*y = _invD[INV_CONV].inventoryY + area.top;
+			}
+			return _noirConvIndices[i];
+		}
+	}
+	return NOOBJECT;
 }
 
