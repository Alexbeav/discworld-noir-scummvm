+/**
+ * PC 449EC0 faces along solved model X/Z, normalized by the render scale.
+ * Our scene Z is the negative of the solver's original Z. The original
+ * wraps the angle and rounds to the nearest unit (0x1000 = full circle).
+ */
+static int T3DirectionFromModelDelta(int dx, int dz) {
+	const int scale = SysVar(SV_SPRITER_SCALE);
+	assert(scale > 0);
+	dx /= scale;
+	dz = -dz / scale;
+	if (dx == 0 && dz == 0)
+		return -1;
+
+	double angle = atan2((double)dz, (double)dx) * 0x1000 / (2.0 * M_PI);
+	if (angle < 0)
+		angle += 0x1000;
+	return (int)(angle + 0.5) & 0xFFF;
+}
