+	if (flags & MODEL_HAS_ROTATION_TABLE) {
+		uint n = GetAnimationFrameCount(hunks, anim.rotateTablesHunk, anim.rotateTables);
+		numFrames = (numFrames == 0) ? n : MIN(numFrames, n);
