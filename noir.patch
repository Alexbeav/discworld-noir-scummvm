+			// the front face; side 0 contributes only on two-sided parts.
+			const int side = (p[2].x() - p[1].x()) * (p[0].y() - p[1].y()) -
+				(p[2].y() - p[1].y()) * (p[0].x() - p[1].x()) > 0;
+			int shade = 0;
+			if (side || part.cull) {
